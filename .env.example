# FargoVPN does not automatically load dotenv files. This file is a reference
# for environment variables accepted by the installer and deployment scripts.
# Production application settings are written to config.py with mode 0600.
# NEVER put real credentials into this file or commit a populated .env.

# Installer / PostgreSQL bootstrap
FARGOVPN_DB_NAME=fargovpn
FARGOVPN_DB_USER=fargovpn
FARGOVPN_DB_HOST=127.0.0.1
FARGOVPN_DB_PORT=5432
FARGOVPN_DB_PASSWORD=

# Optional bootstrap overrides. Normally the installer resolves the latest
# published GitHub Release automatically.
FARGOVPN_ARCHIVE_URL=
FARGOVPN_CHECKSUM_URL=
FARGOVPN_BOOTSTRAP_TMPDIR=/var/tmp

# Optional runtime values consumed by the generated config.py.
# These are examples only; configure real values through the panel or the
# server-side config.py during installation.
BOT_TOKEN=
MASTER_API_TOKEN=
GITHUB_API_TOKEN=
WEB_SECRET_KEY=
PUSH_VAPID_SUBJECT=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY_PATH=/var/lib/vpn-service/vapid_private.pem
