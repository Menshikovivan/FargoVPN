[Unit]
Description=FargoVPN external Nginx path integration guard
After=nginx.service vpn-service-web.service

[Service]
Type=simple
User=root
WorkingDirectory=@TARGET@
ExecStart=@TARGET@/.venv/bin/python @TARGET@/nginx_panel_guard.py
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc/nginx/conf.d /run

[Install]
WantedBy=multi-user.target
